[app]
title = LumaRadio
package.name = lumaradio
package.domain = org.trickynerdy
source.dir = pygame_app
source.include_exts = py,png,svg,json
version = 0.2.0
requirements = python3,pygame
orientation = portrait
fullscreen = 0
